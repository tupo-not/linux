		interrupts = <0x00 0x1a5 0x04>;
		id = <0x02>;
		reset-vector = <0x7ec00000 0x100000 0x800000>;
		main-prog = <0x7ed00000 0x300000 0x900000>;
		kernel-lib = <0x7f000000 0x500000 0xffffffff>;
		work-buf = <0x0 0x12000 0xffffffff>;
		iommus = <&iommu2 0x2a0>;
		phandle = <0x31>;
	};
	mmsram@1f005000 {
		compatible = "mediatek,mmsram";
		reg = <0x0 0x1f005000 0x0 0x1000 0x0 0x1e000000 0x0 0x160000>;
		interrupts = <0x00 0x1ef 0x04>;
		clocks = <&scpsys 0x13 &mdpsys_config 0x22 &mdpsys_config 0x25 &mdpsys_config 0x29 &mdpsys_config 0x2b &mdpsys_config 0x21>;
		clock-names = "scp_mdp", "mdp_apmcu_gals", "mdp_smi0", "mdp_smi1", "mdp_smi2", "mdp_mmsysram";
	};
	audsys: syscon@11210000 {
		compatible = "mediatek,mt6893-audsys", "syscon";
		reg = <0x0 0x11210000 0x0 0x2000>;
		#clock-cells = <0x01>;
		phandle = <0x1c8>;

		afe: audio-controller {
			compatible = "mediatek,mt6893-audio";
			interrupts = <0x00 0xca 0x04 0x00>;
			power-domains = <&spm 0x11>;
			mediatek,apmixedsys = <0x9f>;
			mediatek,infracfg = <0x3c>;
			mediatek,topckgen = <0x3a>;
			clocks = <&audsys 0x0 &audsys 0x7 &audsys 0x8 &audsys 0x6 &audsys 0x15 &audsys 0x1 &audsys 0x2 &audsys 0x4 &audsys 0x3 &audsys 0x5 &audsys 0x9 &audsys 0xa &audsys 0x12 &audsys 0x13 &audsys 0x14 &audsys 0x16 &audsys 0x17 &audsys 0x18 &audsys 0x19 &audsys 0x1a &infracfg_ao 0x22 &infracfg_ao 0x28 &topckgen 0x73 &topckgen 0x74 &topckgen 0x4 &topckgen 0x87 &apmixed 0xd &topckgen 0x88 &apmixed 0xe &topckgen 0x83 &topckgen 0x31 &topckgen 0x84 &topckgen 0x34 &topckgen 0x96 &topckgen 0x97 &topckgen 0x98 &topckgen 0x99 &topckgen 0x9a &topckgen 0x9b &topckgen 0x9c &topckgen 0x9d &topckgen 0x9e &topckgen 0x9f &topckgen 0xa2 &topckgen 0xa3 &topckgen 0xa4 &topckgen 0xa5 &topckgen 0xa6 &topckgen 0xa7 &topckgen 0xa8 &topckgen 0xaa &topckgen 0xab &topckgen 0xac &topckgen 0xad &topckgen 0x90 &clk26m>;
			clock-names = "aud_afe_clk", "aud_dac_clk", "aud_dac_predis_clk", "aud_adc_clk", "aud_adda6_adc_clk", "aud_apll22m_clk", "aud_apll24m_clk", "aud_apll1_tuner_clk", "aud_apll2_tuner_clk", "aud_tdm_clk", "aud_tml_clk", "aud_nle", "aud_dac_hires_clk", "aud_adc_hires_clk", "aud_adc_hires_tml", "aud_adda6_adc_hires_clk", "aud_3rd_dac_clk", "aud_3rd_dac_predis_clk", "aud_3rd_dac_tml", "aud_3rd_dac_hires_clk", "aud_infra_clk", "aud_infra_26m_clk", "top_mux_audio", "top_mux_audio_int", "top_mainpll_d4_d4", "top_mux_aud_1", "top_apll1_ck", "top_mux_aud_2", "top_apll2_ck", "top_mux_aud_eng1", "top_apll1_d4", "top_mux_aud_eng2", "top_apll2_d4", "top_i2s0_m_sel", "top_i2s1_m_sel", "top_i2s2_m_sel", "top_i2s3_m_sel", "top_i2s4_m_sel", "top_i2s5_m_sel", "top_i2s6_m_sel", "top_i2s7_m_sel", "top_i2s8_m_sel", "top_i2s9_m_sel", "top_apll12_div0", "top_apll12_div1", "top_apll12_div2", "top_apll12_div3", "top_apll12_div4", "top_apll12_divb", "top_apll12_div5", "top_apll12_div6", "top_apll12_div7", "top_apll12_div8", "top_apll12_div9", "top_mux_audio_h", "top_clk26m_clk";
			phandle = <0x282>;
		};
	};
	spm_syscon: syscon@10006000 {
		compatible = "mediatek,mt6893-scpsys", "syscon", "simple-mfd";
		reg = <0x0 0x10006000 0x0 0x1000>;
		phandle = <0x28a>;

		spm: power-controller {
			compatible = "mediatek,mt6893-power-controller";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			#power-domain-cells = <0x01>;
			mediatek,infracfg = <0x3c>;
			phandle = <0x1c7>;

			power-domain@17 {
				reg = <0x11>;
				clocks = <&topckgen 0x74 &infracfg_ao 0x28 &infracfg_ao 0x22>;
				clock-names = "audio", "audio1", "audio2";
				#power-domain-cells = <0x00>;
			};
		};
	};
	usb@11201000 {
		compatible = "mediatek,mtu3";
		reg = <0x00 0x11201000 0x00 0x2e00 0x00 0x11203e00 0x00 0x100>;
		reg-names = "mac", "ippc";
		ranges = <0x0 0x0 0x0 0x11200000 0x0 0x3f00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		interrupt-parent = <&gic>;
		interrupts = <0x00 0x60 0x04>;
		clocks = <&topckgen 0x7b &infracfg_ao 0x25 &infracfg_ao 0x3b>;
		clock-names = "sys_ck", "ref_ck", "xhci_ck";
		phys = <&u2port &mt6360_pmu>;
		dr_mode = "otg";
		maximum-speed = "high-speed";
		vusb33-supply = <&vusb33>;
		status = "okay";
		usb-role-switch;
		role-switch-default-mode = "peripheral";
		vbus-supply = <&otg_vbus>;
		phandle = <0xf2>;

		usb@0 {
			compatible = "mediatek,mtk-xhci";
			reg = <0x0 0x0 0x0 0x1000>;
			reg-names = "mac";
			interrupt-parent = <&gic>;
			interrupts = <0x00 0x61 0x04>;
			clocks = <&topckgen 0x7b &infracfg_ao 0x25 &infracfg_ao 0x3b>;
			clock-names = "sys_ck", "ref_ck", "xhci_ck";
			status = "okay";
		};
	};
	smi_larb0@14003000 {
		compatible = "mediatek,mt6873-smi-larb", "mediatek,smi_larb0", "mediatek,smi_larb";
		reg = <0x0 0x14003000 0x0 0x1000>;
		interrupts = <0x00 0x11b 0x04>;
		mediatek,larb-id = <0x0>;
		mediatek,smi-id = <0x0>;
		mediatek,smi = <0x288>;
		clocks = <&clk26m &clk26m &clk26m &clk26m>;
		clock-names = "apb", "smi", "async", "gals";
		phandle = <0xc6>;
	};
	smi_larb1@14004000 {
		compatible = "mediatek,mt6873-smi-larb", "mediatek,smi_larb1", "mediatek,smi_larb";
		reg = <0x0 0x14004000 0x0 0x1000>;
		interrupts = <0x00 0x11a 0x04>;
		mediatek,larb-id = <0x01>;
		mediatek,smi-id = <0x01>;
		mediatek,smi = <0x288>;
		clocks = <&clk26m &clk26m &clk26m &clk26m>;
		clock-names = "apb", "smi", "async", "gals";
		phandle = <0xeb>;
	};
	disp_smi_common@14002000 {
		compatible = "mediatek,mt6873-smi-common", "mediatek,smi_common", "mediatek,disp_smi_common";
		reg = <0x0 0x14002000 0x0 0x1000>;
		mediatek,smi-id = <0x0>;
		clocks = <&clk26m &clk26m &clk26m &clk26m &clk26m>;
		clock-names = "apb", "smi", "async", "gals0", "gals1";
		phandle = <0x288>;
	};
};
