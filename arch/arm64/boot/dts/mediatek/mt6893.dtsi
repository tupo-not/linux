	pwrap: pwrap@10026000 {
		compatible = "mediatek,mt6893-pwrap", "syscon";
		reg = <0x0 0x10026000 0x0 0x1000 0x0 0x10028000 0x0 0x1000>;
		reg-names = "pwrap", "spi_mst";
