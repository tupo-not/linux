	pio: pinctrl {
		compatible = "mediatek,mt6893-pinctrl";
		pins-are-numbered;
		gpio-controller;
		gpio-ranges = <0x02 0x00 0x00 0xdc>;
		#gpio-cells = <0x02>;
		interrupt-controller;
		#interrupt-cells = <0x02>;
		interrupts = <0x00 0xd4 0x04>;
		interrupt-parent = <&gic>;
		phandle = <0x02>;
		reg = <0x0 0x10005000 0x0 0x1000 0x0 0x11c20000 0x0 0x1000 0x0 0x11d10000 0x0 0x1000 0x0 0x11e20000 0x0 0x1000 0x0 0x11e70000 0x0 0x1000 0x0 0x11ea0000 0x0 0x1000 0x0 0x11f20000 0x0 0x1000 0x0 0x11f30000 0x0 0x1000 0x0 0x1000b000 0x0 0x1000>;
		reg-names = "base", "rm", "bm", "lm", "lb", "rt", "lt", "tm", "eint";
		mediatek,eint-keep-unmasked = <0x0c>;












































