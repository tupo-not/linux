	msdc0: msdc@11230000 {
		compatible = "mediatek,msdc", "syscon";
		reg = <0x0 0x11230000 0x0 0x10000>;
		interrupts = <0x00 0x63 0x04>;
		#clock-cells = <0x01>;
		index = [00];
		clk_src = [01];
		bus-width = <0x08>;
		max-frequency = <0xbebc200>;
		cap-mmc-highspeed;
		mmc-ddr-1_8v;
		mmc-hs200-1_8v;
		mmc-hs400-1_8v;
		no-sd;
		no-sdio;
		non-removable;
		pinctl = <0x46>;
		pinctl_hs400 = <0x47>;
		pinctl_hs200 = <0x48>;
		register_setting = <0x49>;
		host_function = [00];
		bootable;
		status = "okay";
		vmmc-supply = <&mt_pmic_vemc_ldo_reg>;
		vcore-supply = <&mt_pmic_vgpu11_buck_reg>;
		clocks = <&infracfg_ao 0x21 &infracfg_ao 0x1f &infracfg_ao 0x51>;
		clock-names = "msdc0-clock", "msdc0-hclock", "msdc0-aes-clock";
		phandle = <0x104>;
