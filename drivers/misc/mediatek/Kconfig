# chopin: minimal gate for the vendor pieces the mediatek_v2 display stack needs
menu "MediaTek vendor glue"

config MTK_CMDQ_MBOX_EXT
	bool "MediaTek CMDQ extension (vendor, needed by mediatek_v2)"
	depends on ARCH_MEDIATEK
	default DRM_MEDIATEK_V2

config MTK_NVRAM_STAGE
	bool "Stage connsys NVRAM blobs in kernel memory"
	depends on SYSFS
	default y
	help
	  Expose /sys/kernel/mtk_nvram/{wifi,bt_addr} so an early userspace
	  helper can hand per-device calibration blobs to built-in connsys
	  drivers.  Needed because kernel threads cannot open nvdata after
	  switch_root.

endmenu

# chopin: the downstream connectivity stack (conninfra + CONNAC2X2 SOC3_0
# fullmac Wi-Fi), imported from the MT6895-Mainline tree and adapted to 6893.
source "drivers/misc/mediatek/connectivity/Kconfig"
source "drivers/misc/mediatek/btif/Kconfig"


config MTK_SCP_CHOPIN
	bool "MediaTek MT6893 SCP boot and mailbox driver"
	depends on ARCH_MEDIATEK
	help
	  Start the MT6893 SCP core (the sensor hub / audio DSP companion)
	  and expose its mailbox through debugfs.  The SCP firmware is
	  pre-loaded by the bootloader; this driver only powers the core
	  up and provides the AP side of the mailbox.

# chopin: SCP (RV) driver and the SCP-backed sensor hub, ported from the
# MT6895-Mainline tree (drivers/misc/mediatek/{scp,sensor}).
source "drivers/misc/mediatek/scp/Kconfig"
source "drivers/misc/mediatek/sensor/2.0/Kconfig"
